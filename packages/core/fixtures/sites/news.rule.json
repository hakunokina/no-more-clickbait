  "exclude": { "within": ["span.np-inline-promo"] },
  "collect": { "method": "static" },
  "pagination": { "type": "load-more", "selector": "button.np-more", "maxPages": 3 },
  "health": { "minItems": 3 },
  "origin": "manual",
  "createdAt": "2026-10-15T11:20:00Z",
