# No More Clickbait — non-secret configuration ONLY.
#
# Secrets NEVER belong in this file or any .env file. Future provider
# credentials are stored through the OS keychain (Electron safeStorage);
# the phase-1 `claude` CLI keeps its own login, which we never read.

# Where the native host drops validated post batches for the desktop app.
# Leave unset to accept-and-discard (bridge smoke-testing only).
# NMC_INBOX_DIR=C:\Users\you\AppData\Local\NoMoreClickbait\inbox

# Log verbosity for the desktop app and native host: error | info | debug
# NMC_LOG_LEVEL=info
