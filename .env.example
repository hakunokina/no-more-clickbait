# No More Clickbait — non-secret configuration ONLY.
#
# Secrets NEVER belong in this file or any .env file. Future provider
# credentials are stored through the OS keychain (Electron safeStorage);
# the phase-1 `claude` CLI keeps its own login, which we never read.

# Where the native host writes developer captures (one <session-time>
# folder per host run, with a summary.json); unset, they go to
# %LOCALAPPDATA%\nmc\captures\<session-time>\. Collected post batches for
# the desktop app always go to %LOCALAPPDATA%\NoMoreClickbait\sessions\.
# Always point this OUTSIDE the repo: raw captures are personal data.
# NMC_INBOX_DIR=C:\Users\you\AppData\Local\NoMoreClickbait\captures

# Log verbosity for the desktop app and native host: error | info | debug
# NMC_LOG_LEVEL=info
