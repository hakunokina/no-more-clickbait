{
  "name": "no-more-clickbait",
  "version": "0.1.0",
  "private": true,
  "description": "Your own feed, filtered: clickbait scoring + claim verification with your own LLM, ending after N posts.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @nmc/desktop start",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "brand:icons": "node scripts/brand-icons.mjs",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
