{
  "manifest_version": 3,
  "name": "No More Clickbait",
  "version": "0.1.0",
  "key": "",
  "description": "Reads your own X home timeline from your own browser session and hands it to the No More Clickbait desktop app for clickbait filtering. Your cookies never leave this device.",
  "icons": { "128": "icon-128.png" },
  "default_locale": "en",
  "permissions": ["storage", "nativeMessaging", "notifications", "scripting", "offscreen"],
  "optional_permissions": ["alarms"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "No More Clickbait",
    "default_icon": { "128": "icon-128.png" }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.reddit.com/*"],
      "js": ["reddit-injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.reddit.com/*"],
      "js": ["reddit-content.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ]
}
